# RoadSense AI — Backend Environment Configuration Example
PROJECT_NAME="RoadSense AI"
API_V1_STR="/api"
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration
# Default local SQLite:
DATABASE_URL="sqlite:///./roadsense.db"
# Production PostgreSQL example:
# DATABASE_URL="postgresql://user:password@localhost:5432/roadsense_db"

# Mode configuration
DEMO_MODE="true"
MAX_UPLOAD_SIZE_MB=15
